{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telegram-birthday-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "birthday-bot-db",
      "database_id": "8e9c1eab-c709-484a-bdc3-57b8d64375eb",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "72a335b0b6114996a5595481e14c060e"
    }
  ]
}
